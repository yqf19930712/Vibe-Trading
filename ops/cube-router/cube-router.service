[Unit]
Description=cube-router (Vibe-Trading multi-tenant orchestrator on CubeSandbox)
After=network-online.target cube-sandbox-control.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cube-router
EnvironmentFile=/opt/cube-router/router.env
ExecStart=/opt/cube-router/.venv/bin/uvicorn router:app --host 0.0.0.0 --port 8990
Restart=always
RestartSec=3
MemoryMax=1G

[Install]
WantedBy=multi-user.target
